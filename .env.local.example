# Local development against a separate dev database (see README > Local development).
# Copy to .env.local (git-ignored) and fill in your dev Supabase project's values from
# Supabase > Project Settings > API Keys. Never put the live project's values here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Same values for server-side rendering
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Shows the email + password dev login on /auth (dev server only)
VITE_DEV_LOGIN=true
